# Copy to `.env` and fill in. The .env file is blocked from web access by .htaccess.

# Where contact-form messages are delivered (also shown on the page as a mailto link)
CONTACT_EMAIL=mikecretaofficial@gmail.com

# Sender address for outgoing mail. Use an address on your own domain
# (e.g. no-reply@yourdomain.com) so hosts and spam filters accept it.
MAIL_FROM=mikecretaofficial@gmail.com

# "mail" = PHP mail() (works on most shared hosting)
# "log"  = write messages to storage/mail.log instead of sending (local development)
MAIL_DRIVER=mail

# Set to true while developing to show PHP errors
APP_DEBUG=true
