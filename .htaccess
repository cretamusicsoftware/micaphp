# Apache config (shared hosting / cPanel). For nginx see README.md.

Options -Indexes
DirectoryIndex index.php

# Never serve secrets or project plumbing
<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|README\.md)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.env\.example$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Long-lived caching for built assets (URLs carry ?v=<mtime>)
  <FilesMatch "\.(css|js|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # theme-init.js is tiny and must stay fresh-ish
  <Files "theme-init.js">
    Header set Cache-Control "public, max-age=3600"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

